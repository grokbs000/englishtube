.36,"text":"It's Tuesday.","en":"It's Tuesday.","zh":"今天是星期二。"},{"start":160.76,"duration":3.42,"text":"I'm hungry. I had an apple yesterday.","en":"I'm hungry. I had an apple yesterday.","zh":"我餓了。我昨天吃了一個蘋果。"},{"start":165.48,"duration":2.1,"text":"Wow. There's an orange.","en":"Wow. There's an orange.","zh":"哇。有一個橘子。"},{"start":171.48,"duration":1.8,"text":"Umm~ Yummy!","en":"Umm~ Yummy!","zh":"嗯~好吃！"},{"start":180.7,"duration":2.0,"text":"Hmm.... What day is it?","en":"Hmm.... What day is it?","zh":"嗯……今天是什麼日子？"},{"start":183.02,"duration":1.28,"text":"It's Wednesday.","en":"It's Wednesday.","zh":"今天是星期三。"},{"start":184.74,"duration":3.76,"text":"I'm hungry. I had an orange yesterday.","en":"I'm hungry. I had an orange yesterday.","zh":"我餓了。我昨天吃了一個橘子。"},{"start":189.12,"duration":2.36,"text":"Wow. There's a tomato.","en":"Wow. There's a tomato.","zh":"哇。有一個西紅柿。"},{"start":195.26,"duration":1.76,"text":"Umm~ Yummy!","en":"Umm~ Yummy!","zh":"嗯~好吃！"},{"start":207.84,"duration":1.62,"text":"What day is today?","en":"What day is today?","zh":"今天是什麼日子？"},{"start":209.86,"duration":1.4,"text":"It's Thursday.","en":"It's Thursday.","zh":"今天是星期四。"},{"start":212.34,"duration":2.74,"text":"I'm... I...","en":"I'm... I...","zh":"我是……我……"},{"start":223.94,"duration":2.26,"text":"Wake up! It's Friday!","en":"Wake up! It's Friday!","zh":"醒醒吧！今天是星期五！"},{"start":227.66,"duration":0.94,"text":"Sorry?","en":"Sorry?","zh":"對不起？"},{"start":229.44,"duration":4.38,"text":"Friday! It's Fri.... Wow!","en":"Friday! It's Fri.... Wow!","zh":"星期五！今天是星期五……哇！"},{"start":234.58,"duration":2.66,"text":"I can fly! I can fly!","en":"I can fly! I can fly!","zh":"我能飛！我能飛！"},{"start":238.2,"duration":2.56,"text":"Wow! Beautiful!","en":"Wow! Beautiful!","zh":"哇！美麗的！"}],"words":[]}